{
  "languages": {
    "Python": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true
      },
      "language_servers": [
        "ty",
        "ruff",
        "sqlakit-lsp",
        "!basedpyright",
        "!pyright",
        "!pylsp"
      ]
    },
    "SQL": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "uv",
          "arguments": [
            "run",
            "--frozen",
            "sqruff",
            "fix",
            "-"
          ]
        }
      },
      "language_servers": [
        "sqlakit-lsp",
        "..."
      ]
    }
  }
}
