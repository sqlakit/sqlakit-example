{
  // The project's own Python, so ruff and ty run from `.venv`.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // ty checks the types, in place of the Python extension's own server.
  "python.languageServer": "None",

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },

  "[sql]": {
    "editor.defaultFormatter": "Quary.sqruff",
    "editor.formatOnSave": true,
    "editor.semanticHighlighting.enabled": true
  },

  "ty.inlayHints.variableTypes": false,
  "ty.inlayHints.callArgumentNames": false,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,

  // `python -m shop.seed` writes it, and nothing in it is worth a search.
  "search.exclude": {
    "shop.db": true
  }
}
